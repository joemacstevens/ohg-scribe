# Database
DATABASE_URL=postgresql://ohgscribe:ohgscribe@localhost:5432/ohgscribe

# API Keys (server-managed — never sent to clients)
ASSEMBLYAI_API_KEY=your_assemblyai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Local dev auth bypass (leave empty in prod to require Entra ID)
DEV_USER_EMAIL=dev@example.com

# Deployment (set by CI/CD or Cloudmersive)
PUBLIC_BASE_PATH=
STATIC_DIR=../frontend/build
